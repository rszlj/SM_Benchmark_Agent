{
  "schema": "benchmark-source-skill-index-v1",
  "path_base": "repository_root",
  "context_prerequisites": [
    "srtm",
    "hwsd2",
    "mcd12q1"
  ],
  "workflows": {
    "contexts": {
      "command": "sm-benchmark-context",
      "subcommand": "prepare",
      "guide": "docs/context-preparation.md",
      "example": "configs/context-request.example.json",
      "extra": "contexts",
      "scope": "one anchor/year; absent targets; all three context sources required",
      "included_sources": [
        "srtm",
        "hwsd2",
        "mcd12q1"
      ],
      "requires_context": false
    },
    "gldas": {
      "command": "sm-benchmark-agent",
      "selector": [
        "--workflow",
        "gldas"
      ],
      "guide": "docs/gldas-pilot.md",
      "example": "configs/gldas-request.example.json",
      "extra": "gldas",
      "scope": "one anchor/year; absent targets; four GLDAS layers and reviewed contexts",
      "requires_context": true
    },
    "modis": {
      "command": "sm-benchmark-modis",
      "guide": "docs/modis-preparation.md",
      "example": "configs/modis-request.example.json",
      "extra": "modis",
      "scope": "one anchor/year; absent targets; selected separate MODIS sources and reviewed contexts",
      "requires_context": true
    },
    "timeseries": {
      "command": "sm-benchmark-timeseries",
      "guide": "docs/timeseries-preparation.md",
      "example": "configs/timeseries-request.example.json",
      "extra": "timeseries",
      "scope": "one anchor/year; absent targets; selected ERA5-Land/IMERG sources and reviewed contexts",
      "requires_context": true
    },
    "sentinel1": {
      "command": "sm-benchmark-sentinel1",
      "guide": "docs/sentinel1-preparation.md",
      "example": "configs/sentinel1-request.example.json",
      "extra": "sentinel1",
      "scope": "one anchor/year; absent targets; Sentinel-1 and reviewed contexts",
      "requires_context": true
    },
    "smap": {
      "command": "sm-benchmark-smap",
      "guide": "docs/smap-preparation.md",
      "example": "configs/smap-request.example.json",
      "extra": "smap",
      "scope": "one anchor/year; absent targets; SMAP v007 legacy GEE sampling and reviewed contexts; native-cell equivalence unverified",
      "requires_context": true
    }
  },
